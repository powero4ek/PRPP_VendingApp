@startuml
actor Пользователь as User
participant "MainViewModel" as VM
participant "MonitorViewModel" as MVM
participant "ApiService" as API
participant "MachinesController" as Ctrl
participant "VendingDbContext" as DB
participant "PostgreSQL" as SQL

User -> VM : Нажать "Монитор ТА"
VM -> MVM : Создать MonitorViewModel
activate MVM

MVM -> API : GetMonitorDataAsync(status, paymentType)
activate API
API -> Ctrl : GET /api/machines/monitor
activate Ctrl
Ctrl -> DB : Запрос Machines
activate DB
DB -> SQL : SELECT ... FROM Machines
activate SQL
SQL --> DB : Данные ТА
DB --> Ctrl : List<Machine>
Ctrl --> API : 200 OK + JSON
API --> MVM : Десериализация List<Machine>

MVM -> MVM : Генерация динамических данных
(ConnectionStatus, LoadPercent, MoneyInMachine)
MVM -> MVM : Расчет TotalMachines, TotalMoney
MVM --> VM : Обновление UI
VM --> User : Отображение таблицы Монитора ТА

User -> MVM : Выбрать фильтр "Работает"
MVM -> API : GetMonitorDataAsync("Работает", null)
API -> Ctrl : GET /api/machines/monitor?status=Работает
Ctrl -> DB : Фильтрация по статусу
DB -> SQL : SELECT ... WHERE MachineStatus='Работает'
SQL --> DB : Отфильтрованные данные
DB --> Ctrl : Отфильтрованный список
Ctrl --> API : 200 OK
API --> MVM : Обновленные данные
MVM -> MVM : Пересчет TotalMoney
MVM --> VM : Обновление UI
VM --> User : Отображение отфильтрованных ТА

User -> MVM : Нажать "Сортировать по статусу"
MVM -> MVM : OrderBy(m => m.MachineStatus)
MVM --> VM : Обновление ObservableCollection
VM --> User : Отсортированная таблица

deactivate SQL
deactivate DB
deactivate Ctrl
deactivate API
deactivate MVM
@enduml
