<UserControl x:Class="VendingDesktop.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Монитор ТА" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="StatusFilter" Width="150" Margin="5" SelectedItem="{Binding FilterStatus}" ToolTip="Общее состояние">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Работает"/>
                <ComboBoxItem Content="Вышел из строя"/>
                <ComboBoxItem Content="В ремонте/на обслуживании"/>
            </ComboBox>
            <ComboBox x:Name="PaymentFilter" Width="150" Margin="5" SelectedItem="{Binding FilterPayment}" ToolTip="Тип подключения">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="с оплатой картой"/>
                <ComboBoxItem Content="с оплатой наличными"/>
                <ComboBoxItem Content="два вида оплаты"/>
            </ComboBox>
            <Button Content="Применить" Command="{Binding ApplyFilterCommand}" Margin="5" Padding="10,5" Background="#4a90d9" Foreground="White"/>
            <Button Content="Сортировать по статусу" Command="{Binding SortByStatusCommand}" Margin="5" Padding="10,5"/>
            <TextBlock Text="Итого автоматов:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <TextBlock Text="{Binding TotalMachines}" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="Денег в автоматах:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <TextBlock Text="{Binding TotalMoney, StringFormat={}{0:C}}" FontWeight="Bold" VerticalAlignment="Center" Foreground="Green"/>
        </StackPanel>

        <!-- Table -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Machines}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#f5f5f5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding MachineID}" Width="50"/>
                <DataGridTextColumn Header="ТП" Binding="{Binding PaymentType}" Width="120"/>
                <DataGridTextColumn Header="Связь" Binding="{Binding ConnectionStatus}" Width="100"/>
                <DataGridTextColumn Header="Загрузка" Binding="{Binding LoadPercent, StringFormat={}{0}%}" Width="80"/>
                <DataGridTextColumn Header="Денежные средства" Binding="{Binding MoneyInMachine, StringFormat={}{0:C}}" Width="130"/>
                <DataGridTextColumn Header="События" Binding="{Binding MachineStatus}" Width="120"/>
                <DataGridTextColumn Header="Оборудование" Binding="{Binding Model}" Width="150"/>
                <DataGridTextColumn Header="Информация" Binding="{Binding Location}" Width="200"/>
                <DataGridTextColumn Header="Доп." Binding="{Binding Country}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
