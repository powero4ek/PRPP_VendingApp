<Window x:Class="VendingDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vending System - Франчайзер" Height="800" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" x:Name="SidebarColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1e1e2d">
            <StackPanel>
                <TextBlock Text="VENDING" Foreground="White" FontSize="20" FontWeight="Bold" Margin="20" HorizontalAlignment="Center"/>

                <!-- User Profile -->
                <Border Background="#2d2d44" CornerRadius="8" Margin="10" Padding="10" Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Ellipse Width="50" Height="50" Fill="Gray"/>
                        <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="White" FontWeight="Bold" Margin="0,5,0,0" TextAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#aaa" FontSize="11" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Content="🏠 Главная" Command="{Binding ShowHomeCommand}" Style="{StaticResource NavButton}"/>
                <Button Content="📊 Монитор ТА" Command="{Binding ShowMonitorCommand}" Style="{StaticResource NavButton}"/>
                <Button Content="📋 Детальные отчеты" Command="{Binding ShowReportsCommand}" Style="{StaticResource NavButton}"/>
                <Button Content="📦 Учет ТМЦ" Command="{Binding ShowInventoryCommand}" Style="{StaticResource NavButton}"/>
                <Button Content="⚙️ Администрирование ТА" Command="{Binding ShowAdminCommand}" Style="{StaticResource NavButton}"/>
                <Separator Margin="10" Background="#444"/>
                <Button Content="🚪 Выход" Command="{Binding LogoutCommand}" Style="{StaticResource NavButton}"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="10"/>
    </Grid>
</Window>
