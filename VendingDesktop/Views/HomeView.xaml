<UserControl x:Class="VendingDesktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Карточки статистики -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                <Border Background="#27ae60" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Всего ТА" Foreground="White" FontSize="14"/>
                        <TextBlock Text="{Binding Summary.Total}" Foreground="White" 
                                   FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#2ecc71" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Работают" Foreground="White" FontSize="14"/>
                        <TextBlock Text="{Binding Summary.Working}" Foreground="White" 
                                   FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#e74c3c" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Сломаны" Foreground="White" FontSize="14"/>
                        <TextBlock Text="{Binding Summary.Broken}" Foreground="White" 
                                   FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#3498db" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="На обслуживании" Foreground="White" FontSize="14"/>
                        <TextBlock Text="{Binding Summary.Maintenance}" Foreground="White" 
                                   FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Дополнительная статистика -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Продажи" Foreground="#7f8c8d" FontSize="14"/>
                        <TextBlock Text="{Binding Summary.SalesSum, StringFormat={}{0:C}}" 
                                   Foreground="#2c3e50" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Инкассации" Foreground="#7f8c8d" FontSize="14"/>
                        <TextBlock Text="{Binding Summary.IncSum, StringFormat={}{0:C}}" 
                                   Foreground="#2c3e50" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Эффективность" Foreground="#7f8c8d" FontSize="14"/>
                        <TextBlock Text="{Binding Summary.Efficiency, StringFormat={}{0}%}" 
                                   Foreground="#2c3e50" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Статусы в текстовом виде (вместо графиков) -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Распределение статусов" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Summary.Working}" FontSize="36" FontWeight="Bold" Foreground="#27ae60"/>
                            <TextBlock Text="Работают" Foreground="#7f8c8d"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Summary.Broken}" FontSize="36" FontWeight="Bold" Foreground="#e74c3c"/>
                            <TextBlock Text="Сломаны" Foreground="#7f8c8d"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Summary.Maintenance}" FontSize="36" FontWeight="Bold" Foreground="#3498db"/>
                            <TextBlock Text="На обслуживании" Foreground="#7f8c8d"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Новости -->
            <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Новости" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <ItemsControl ItemsSource="{Binding NewsList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#ecf0f1" BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" 
                                                   Foreground="#7f8c8d" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding PublishDate, StringFormat=dd.MM.yyyy}" 
                                                   Foreground="#95a5a6" FontSize="12" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>