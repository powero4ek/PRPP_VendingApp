@startuml
skinparam componentStyle rectangle

package "Клиент" {
    [WPF Desktop App] as Desktop
    [Blazor Web App] as Web
}

package "API" {
    [ASP.NET Core API] as API
    [JWT Auth] as Auth
    [CORS Middleware] as CORS
}

package "Services" {
    [CsvImportService] as CsvSvc
    [ScheduleService] as SchSvc
    [JwtService] as JwtSvc
    [AuthService] as AuthSvc
}

package "Data Access" {
    [Entity Framework Core] as EF
    [PostgreSQL] as DB
}

package "External" {
    [Postman] as Postman
}

Desktop --> API : HTTP/REST
Web --> API : HTTP/REST
Postman --> API : HTTP/REST

API --> Auth : использует
API --> CORS : использует
API --> JwtSvc : использует
API --> AuthSvc : использует
API --> CsvSvc : использует
API --> SchSvc : использует

AuthSvc --> EF : запросы
CsvSvc --> EF : запросы
SchSvc --> EF : запросы

EF --> DB : SQL

Desktop --> Auth : JWT Token
Web --> Auth : JWT Token

@enduml
